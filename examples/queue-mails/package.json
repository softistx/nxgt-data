{
	"name": "queue-mails-example",
	"version": "0.0.0",
	"private": true,
	"description": "Tenant mails through an @nxgt/redis queue: a producer, a worker, groups, a nightly digest and durable steps. The example is not published",
	"type": "module",
	"scripts": {
		"producer": "bun src/producer.ts",
		"worker": "bun src/worker.ts",
		"typecheck": "tsc --noEmit",
		"test": "bun ../../scripts/redis.ts && REDIS_BIN=$(bun ../../scripts/redis.ts) bun test --timeout 60000 src",
		"lint": "biome lint",
		"check": "biome check --write"
	},
	"dependencies": {
		"@nxgt/redis": "workspace:^",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@types/bun": "^1.4.4",
		"redis-memory-server": "0.17.1",
		"typescript": "~6.0.3"
	}
}
