{
	"name": "hono-api-example",
	"version": "0.0.0",
	"private": true,
	"description": "A Hono API on @nxgt/mongo-kit, from an OpenAPI spec: the example is not published",
	"type": "module",
	"scripts": {
		"generate:api": "nxgt-openapi generate",
		"check:api": "nxgt-openapi generate --check",
		"dev": "bun --watch src/index.ts",
		"sync": "bun src/sync.ts",
		"typecheck": "bun run generate:api && tsc --noEmit",
		"test": "bun run generate:api && bun test src",
		"lint": "biome lint",
		"check": "biome check --write"
	},
	"dependencies": {
		"@nxgt/mongo": "workspace:^",
		"@nxgt/mongo-kit": "workspace:^",
		"@nxgt/openapi-hono": "^0.3.0",
		"hono": "^4.13.8",
		"mongodb": "7.6.0",
		"zod": "4.6.5"
	},
	"devDependencies": {
		"@nxgt/openapi-codegen": "^0.4.0",
		"@redocly/openapi-core": "^2.52.1",
		"@types/bun": "^1.4.0",
		"mongodb-memory-server-core": "11.2.0",
		"typescript": "~6.0.3"
	}
}
