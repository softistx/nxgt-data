{
	"name": "mongo-backup-job-example",
	"version": "0.0.0",
	"private": true,
	"description": "A scheduled MongoDB backup on @nxgt/mongo-backup's mongoBackups: run hourly, drill daily. The example is not published",
	"type": "module",
	"scripts": {
		"backup": "bun src/index.ts backup",
		"drill": "bun src/index.ts drill",
		"typecheck": "tsc --noEmit",
		"test": "bun test --timeout 60000 src",
		"lint": "biome lint",
		"check": "biome check --write",
		"keygen": "nxgt-mongo-backup keygen"
	},
	"dependencies": {
		"@nxgt/mongo-backup": "workspace:^",
		"@nxgt/backup": "workspace:^",
		"mongodb": "7.6.0"
	},
	"devDependencies": {
		"@types/bun": "^1.4.0",
		"mongodb-memory-server-core": "11.2.0",
		"typescript": "~6.0.3"
	}
}
