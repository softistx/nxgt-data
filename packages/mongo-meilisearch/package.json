{
	"name": "@nxgt/mongo-meilisearch",
	"version": "0.4.2",
	"description": "Keeps a Meilisearch index in step with a MongoDB collection: a typed transform, a full reindex, and a change stream that resumes where it stopped",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"mongodb",
		"meilisearch",
		"search",
		"sync",
		"change-streams",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-data.git",
		"directory": "packages/mongo-meilisearch"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun run ../../scripts/meilisearch.ts && bun test --timeout 30000 src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@nxgt/meilisearch": "workspace:^",
		"@nxgt/mongo": "workspace:^",
		"@types/bun": "^1.4.0",
		"meilisearch": "0.62.0",
		"mongodb": "7.6.0",
		"mongodb-memory-server-core": "11.2.0",
		"zod": "4.6.5"
	},
	"peerDependencies": {
		"@nxgt/meilisearch": "workspace:^",
		"@nxgt/mongo": "workspace:^",
		"meilisearch": ">=0.62.0 <1",
		"mongodb": ">=7.0.0 <8",
		"typescript": "^6.0.3"
	}
}
