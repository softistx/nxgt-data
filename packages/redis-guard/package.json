{
	"name": "@nxgt/redis-guard",
	"version": "0.4.0",
	"description": "Deprecated: moved into @nxgt/redis. Re-exports its rate limits and idempotency under the same names",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"redis",
		"deprecated"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-data.git",
		"directory": "packages/redis-guard"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts"
		]
	},
	"devDependencies": {
		"@nxgt/redis": "workspace:^",
		"@types/bun": "^1.4.0"
	},
	"peerDependencies": {
		"@nxgt/redis": "workspace:^",
		"typescript": "^6.0.3"
	}
}
