{
	"name": "@nxgt/mongo-backup",
	"version": "0.3.1",
	"description": "MongoDB for @nxgt/backup: a full backup read at one cluster time, incremental ones from the change stream, and a restore that lands each collection whole or not at all",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"bin": {
		"nxgt-mongo-backup": "./dist/cli.js"
	},
	"files": [
		"dist",
		"docs",
		"README.md",
		"package.json",
		"LICENSE"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"keywords": [
		"mongodb",
		"backup",
		"restore",
		"snapshot",
		"change-streams",
		"gridfs",
		"bun",
		"typescript"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/softistx/nxgt-data.git",
		"directory": "packages/mongo-backup"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"scripts": {
		"build": "bun run ../../build.ts",
		"test": "bun test --timeout 30000 src",
		"typecheck": "tsc --noEmit"
	},
	"nxgt": {
		"entrypoints": [
			"src/index.ts",
			"src/cli.ts"
		]
	},
	"devDependencies": {
		"@nxgt/backup": "workspace:^",
		"@types/bun": "^1.4.0",
		"mongodb": "7.6.0",
		"mongodb-memory-server-core": "11.2.0"
	},
	"peerDependencies": {
		"@nxgt/backup": "workspace:^",
		"mongodb": ">=7.0.0 <8",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"age-encryption": "~0.3.1"
	}
}
